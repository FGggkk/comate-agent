# Database
DB_PASSWORD=comate_dev
DATABASE_URL=postgresql+asyncpg://postgres:${DB_PASSWORD}@localhost:5432/comate

# Email SMTP
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_USER=your-email@qq.com
EMAIL_PASS=your-smtp-token
EMAIL_FROM=伴行agent <your-email@qq.com>

# Model API
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# JWT
JWT_SECRET=change-this-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=72

# COS - 腾讯云对象存储
COS_SECRET_ID=your-cos-secret-id
COS_SECRET_KEY=your-cos-secret-key
COS_REGION=ap-guangzhou
COS_BUCKET=your-bucket-name

# Embedding - 阿里云百炼
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_WORKSPACE_ID=your-workspace-id
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1536

# Voice - Qwen Audio Realtime（复用上面的 DASHSCOPE_API_KEY 与 DASHSCOPE_WORKSPACE_ID）
# 使用华北2（北京）地域的业务空间和 API Key。
VOICE_ENABLED=false
QWEN_AUDIO_REALTIME_MODEL=qwen-audio-3.0-realtime-flash
QWEN_AUDIO_REALTIME_URL=wss://{workspace_id}.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime
QWEN_AUDIO_REALTIME_VOICE=longanqian
QWEN_AUDIO_REALTIME_MAX_HISTORY_TURNS=12

# Web Search - Firecrawl
FIRECRAWL_API_KEY=your-firecrawl-api-key
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# Weather - 和风天气
HEWEATHER_API_KEY=your-heweather-api-key
HEWEATHER_BASE_URL=https://your-host.re.qweatherapi.com


# App
APP_NAME=comate-agent
DEBUG=true
